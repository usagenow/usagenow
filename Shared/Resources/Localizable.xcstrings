    "UsageNow sends this credential only to %@ to read usage. It is stored in Keychain on this Mac and deleted when you turn %@ off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow sendet diese Zugangsdaten nur an %1$@, um die Nutzung zu lesen. Sie liegen im Schlüsselbund dieses Mac und werden beim Ausschalten von %2$@ gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "UsageNow sends this credential only to %1$@ to read usage. It is stored in Keychain on this Mac and deleted when you turn %2$@ off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow envía esta credencial solo a %1$@ para consultar el uso. Se guarda en el Llavero de este Mac y se elimina al desactivar %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow envoie cet identifiant uniquement à %1$@ pour lire l’utilisation. Il est conservé dans le trousseau de ce Mac et supprimé à la désactivation de %2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow שולח את פרטי האימות רק ל־%1$@ לקריאת השימוש. הם נשמרים במחזיק המפתחות ב־Mac הזה ונמחקים כשמכבים את %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNowは使用量の読み取りのため、この認証情報を%1$@にのみ送信します。このMacのキーチェーンに保存され、%2$@をオフにすると削除されます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow бұл кіру деректерін қолданысты оқу үшін тек %1$@ сервисіне жібереді. Олар осы Mac-тың Кілттер тізбегінде сақталып, %2$@ өшірілгенде жойылады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow는 사용량을 읽기 위해 이 인증 정보를 %1$@에만 보냅니다. 이 Mac의 키체인에 저장되며 %2$@을(를) 끄면 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow stuurt deze toegangsgegevens alleen naar %1$@ om verbruik te lezen. Ze worden in Sleutelhanger op deze Mac bewaard en verwijderd wanneer je %2$@ uitschakelt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O UsageNow envia esta credencial apenas a %1$@ para ler o uso. Ela fica nas Chaves deste Mac e é apagada ao desativar %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow отправляет эти данные только на %1$@ для чтения использования. Они хранятся в Связке ключей этого Mac и удаляются при отключении %2$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow bu kimlik bilgisini kullanımı okumak için yalnızca %1$@ hizmetine gönderir. Bu Mac’in Anahtar Zinciri’nde saklanır ve %2$@ kapatıldığında silinir."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow bu kiriş ma’lumotini sarfni öqiş uçun faqat %1$@’ga yuboradi. U şu Mac’dagi Keychain’da saqlanadi va %2$@ öçirilganda öçiriladi."
          }
        }
      }
    },
    "UsageNow switches language when it restarts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow wechselt die Sprache beim Neustart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow cambiará de idioma al reiniciarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow changera de langue au redémarrage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow יחליף שפה כשיופעל מחדש."
          }
        },
        "ja" : {
