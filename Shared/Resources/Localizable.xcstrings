    "Experimental" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimentell"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimental"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expérimental"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспериментально"
          }
        }
      }
    },
    "Experimental: %@ doesn’t document how to read usage, so this may stop working without notice. If it does, UsageNow shows limits as unavailable rather than guessing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimentell: %@ dokumentiert nicht, wie sich die Nutzung auslesen lässt, daher kann das ohne Vorwarnung aufhören zu funktionieren. Dann zeigt UsageNow die Limits als nicht verfügbar an, statt zu raten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimental: %@ no documenta cómo leer el uso, así que podría dejar de funcionar sin aviso. Si ocurre, UsageNow mostrará los límites como no disponibles en vez de adivinar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expérimental : %@ ne documente pas la lecture de l’utilisation, cela peut donc cesser de fonctionner sans préavis. Dans ce cas, UsageNow affiche les limites comme indisponibles plutôt que de deviner."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспериментально: %@ не документирует, как читать использование, поэтому это может перестать работать без предупреждения. Тогда UsageNow покажет, что лимиты недоступны, а не будет угадывать."
          }
        }
      }
    },
    "Fetch Claude usage limits" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude-Nutzungslimits abrufen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtener los límites de uso de Claude"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupérer les limites d’utilisation de Claude"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получать лимиты Claude"
          }
        }
      }
    },
    "Fetch current Claude Code subscription limits directly from Anthropic using your existing Claude Code sign-in. This uses an undocumented Anthropic endpoint and may stop working without notice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruft die aktuellen Limits deines Claude Code-Abos direkt bei Anthropic ab, mit deiner bestehenden Claude Code-Anmeldung. Dafür wird ein nicht dokumentierter Anthropic-Endpunkt verwendet, der ohne Vorwarnung aufhören kann zu funktionieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtiene los límites actuales de tu suscripción a Claude Code directamente de Anthropic con tu inicio de sesión de Claude Code. Usa un endpoint no documentado de Anthropic y podría dejar de funcionar sin aviso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupère les limites actuelles de votre abonnement Claude Code directement auprès d’Anthropic, avec votre connexion Claude Code existante. Cela utilise un point de terminaison Anthropic non documenté, qui peut cesser de fonctionner sans préavis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получать текущие лимиты подписки Claude Code напрямую у Anthropic с помощью вашего входа в Claude Code. Используется недокументированный эндпоинт Anthropic, он может перестать работать без предупреждения."
          }
        }
      }
    },
