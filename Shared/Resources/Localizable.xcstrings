    },
    "The folder %@ uses when %@ is set to it. Only usage is read from it, as from %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordner, den %1$@ verwendet, wenn %2$@ darauf gesetzt ist. Daraus wird nur die Nutzung gelesen, wie aus %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The folder %1$@ uses when %2$@ is set to it. Only usage is read from it, as from %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta que usa %1$@ cuando %2$@ apunta a ella. Solo se lee el uso, como de %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier qu’utilise %1$@ quand %2$@ pointe vers lui. Seule l’utilisation y est lue, comme dans %3$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התיקייה ש־%1$@ משתמש בה כש־%2$@ מצביע עליה. ממנה נקרא רק השימוש, כמו מ־%3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@がこのフォルダを指しているときに%1$@が使うフォルダです。%3$@と同様に、使用量だけが読み取られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@이(가) 가리킬 때 %1$@이(가) 사용하는 폴더입니다. %3$@에서처럼 사용량만 읽습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De map die %1$@ gebruikt wanneer %2$@ ernaar verwijst. Alleen het verbruik wordt gelezen, net als uit %3$@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta que o %1$@ usa quando %2$@ aponta para ela. Só o uso é lido dela, como de %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка, с которой %1$@ работает, когда в неё указывает %2$@. Из неё читается только использование, как из %3$@."
          }
        }
      }
    },
