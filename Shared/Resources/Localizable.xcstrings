          }
        }
      }
    },
    "UsageNow doesn’t include third-party code. Its own source code is available under the MIT License." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow enthält keinen Code von Drittanbietern. Der eigene Quellcode ist unter der MIT-Lizenz verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow no incluye código de terceros. Su código fuente está disponible bajo la licencia MIT."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow n’inclut pas de code tiers. Son code source est disponible sous licence MIT."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow не включает сторонний код. Его исходный код доступен по лицензии MIT."
          }
        }
      }
    },
    "UsageNow installs an update only when it's signed with the UsageNow update key. Checking sends no information about you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow installiert ein Update nur, wenn es mit dem UsageNow-Update-Schlüssel signiert ist. Bei der Suche werden keine Informationen über dich gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow solo instala una actualización si está firmada con la clave de actualización de UsageNow. Al comprobar no se envía información sobre ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow n’installe une mise à jour que si elle est signée avec la clé de mise à jour de UsageNow. La vérification n’envoie aucune information vous concernant."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow устанавливает обновление, только если оно подписано ключом обновлений UsageNow. Проверка не передаёт никаких сведений о вас."
          }
        }
      }
    },
    "UsageNow is local-first. Your usage data stays on this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow arbeitet lokal. Deine Nutzungsdaten bleiben auf diesem Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow funciona en local. Tus datos de uso se quedan en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow fonctionne en local. Vos données d’utilisation restent sur ce Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow работает локально. Ваши данные об использовании остаются на этом Mac."
          }
        }
      }
    },
    "UsageNow uses this key only to read your usage from %@. It stays in the Keychain on this Mac, is never sent anywhere else, and is deleted when you turn %@ off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow verwendet diesen Schlüssel nur, um deine Nutzung bei %1$@ zu lesen. Er bleibt im Schlüsselbund dieses Mac, wird nirgendwohin sonst gesendet und wird gelöscht, wenn du %2$@ ausschaltest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "UsageNow uses this key only to read your usage from %1$@. It stays in the Keychain on this Mac, is never sent anywhere else, and is deleted when you turn %2$@ off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow usa esta clave solo para leer tu uso en %1$@. Se queda en el Llavero de este Mac, nunca se envía a ningún otro sitio y se elimina cuando desactivas %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow utilise cette clé uniquement pour lire votre utilisation auprès de %1$@. Elle reste dans le trousseau de ce Mac, n’est envoyée nulle part ailleurs et est supprimée lorsque vous désactivez %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow использует этот ключ только для чтения вашего использования у %1$@. Он хранится в Связке ключей этого Mac, никуда больше не отправляется и удаляется, когда вы выключаете %2$@."
          }
        }
      }
    },
