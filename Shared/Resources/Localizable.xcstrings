    "Allow UsageNow in System Settings to finish setup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube UsageNow in den Systemeinstellungen, um die Einrichtung abzuschließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite UsageNow en Ajustes del Sistema para terminar la configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez UsageNow dans Réglages Système pour terminer la configuration."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לסיים את ההגדרה, יש לאשר את UsageNow בהגדרות המערכת."
