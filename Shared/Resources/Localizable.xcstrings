    "Leave the selection empty to follow UsageNow. Select providers and accounts to personalize this widget." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Auswahl leer, um UsageNow zu folgen. Wähle Anbieter und Accounts für dieses Widget aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja la selección vacía para seguir UsageNow. Elige proveedores y cuentas para personalizar este widget."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez la sélection vide pour suivre UsageNow. Sélectionnez des fournisseurs et des comptes pour ce widget."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השאירו את הבחירה ריקה כדי לעקוב אחר UsageNow. בחרו ספקים וחשבונות להתאמה אישית של הווידג׳ט."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未選択の場合はUsageNowの設定に従います。このウィジェットに表示するプロバイダーとアカウントを選択できます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow таңдауын қолдану үшін бос қалдырыңыз. Виджетті баптау үшін провайдерлер мен аккаунттарды таңдаңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택하지 않으면 UsageNow 설정을 따릅니다. 제공업체와 계정을 선택해 이 위젯을 맞춤 설정하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat de selectie leeg om UsageNow te volgen. Selecteer providers en accounts om deze widget aan te passen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe a seleção vazia para seguir o UsageNow. Escolha fornecedores e contas para personalizar este widget."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте выбор пустым, чтобы следовать настройкам UsageNow. Выберите провайдеров и аккаунты для этого виджета."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow’u izlemek için seçimi boş bırakın. Bu araç takımını özelleştirmek için sağlayıcı ve hesapları seçin."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow tanloviga ergaşiş uçun böş qoldiring. Vidjetni moslaş uçun provayder va hisoblarni tanlang."
          }
        }
      }
    },
