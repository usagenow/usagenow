    "Shown after %@ in the menu bar window and the widget. UsageNow never reads the account’s own name or email." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird im UsageNow-Fenster und im Widget nach %@ angezeigt. UsageNow liest nie den Namen oder die E-Mail-Adresse des Accounts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra después de %@ en la ventana de UsageNow y en el widget. UsageNow nunca lee el nombre ni el correo de la cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiché après %@ dans la fenêtre UsageNow et le widget. UsageNow ne lit jamais le nom ni l’adresse e-mail du compte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוצג אחרי %@ בחלון שורת התפריטים ובווידג׳ט. UsageNow לעולם לא קורא את השם או את כתובת הדוא״ל של החשבון עצמו."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーのウインドウとウィジェットで%@の後に表示されます。UsageNowがアカウント自体の名前やメールアドレスを読み取ることはありません。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мәзір терезесі мен виджетте %@ соңынан көрсетіледі. UsageNow аккаунттың өз атауын не эл. поштасын оқымайды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대 윈도우와 위젯에서 %@ 뒤에 표시됩니다. UsageNow는 계정 자체의 이름이나 이메일을 읽지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt na %@ getoond in het menubalkvenster en de widget. UsageNow leest nooit de eigen naam of het e-mailadres van het account."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece depois de %@ na janela da barra de menus e no widget. O UsageNow nunca lê o nome nem o e‑mail da própria conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывается после %@ в окне UsageNow и в виджете. Имя и email самого аккаунта UsageNow не читает."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menü çubuğu penceresinde ve araç takımında %@ sonrasında gösterilir. UsageNow hesabın kendi adını veya e-postasını okumaz."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyu oynasi va vidjetda %@ dan keyin körsatiladi. UsageNow hisobning öz nomi yoki elektron poçtasini öqimaydi."
          }
        }
      }
    },
    "Shows the icon alone when no usage limit is available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt nur das Symbol, wenn kein Nutzungslimit verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra solo el icono cuando no hay ningún límite de uso disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche uniquement l’icône lorsqu’aucune limite d’utilisation n’est disponible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשאין מגבלת שימוש זמינה, מוצגת הצלמית בלבד."
