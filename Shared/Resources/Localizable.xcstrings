    "Install or use a supported AI coding tool to start tracking usage." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiere oder nutze ein unterstütztes KI-Coding-Tool, um die Nutzung zu verfolgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala o usa una herramienta de programación con IA compatible para empezar a seguir el uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez ou utilisez un outil de code IA pris en charge pour commencer le suivi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להתחיל לעקוב אחר השימוש, יש להתקין כלי AI נתמך לתכנות או להשתמש בו."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用量の追跡を始めるには、対応するAIコーディングツールをインストールするか使用してください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бақылауды бастау үшін қолдау көрсетілетін ЖИ құралын орнатыңыз немесе қолданыңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용량 추적을 시작하려면 지원되는 AI 코딩 도구를 설치하거나 사용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installeer of gebruik een ondersteunde AI-codetool om je verbruik bij te houden."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
