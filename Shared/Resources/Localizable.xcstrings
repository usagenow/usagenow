    "Allow UsageNow in System Settings to finish setup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube UsageNow in den Systemeinstellungen, um die Einrichtung abzuschließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite UsageNow en Ajustes del Sistema para terminar la configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez UsageNow dans Réglages Système pour terminer la configuration."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לסיים את ההגדרה, יש לאשר את UsageNow בהגדרות המערכת."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定を完了するには、“システム設定”でUsageNowを許可してください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Орнатуды аяқтау үшін Жүйелік параметрлерде UsageNow-ға рұқсат беріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정을 완료하려면 시스템 설정에서 UsageNow를 허용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta UsageNow toe in Systeeminstellingen om de configuratie af te ronden."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o UsageNow nos Ajustes do Sistema para concluir a configuração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите UsageNow в Системных настройках, чтобы завершить настройку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurulumu tamamlamak için Sistem Ayarları’nda UsageNow’a izin verin."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sozlaşni tugatiş uçun Tizim sozlamalarida UsageNow’ga ruxsat bering."
          }
        }
      }
    },
    "Allow UsageNow to access your Claude Code sign-in in Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube UsageNow den Zugriff auf deine Claude Code-Anmeldung im Schlüsselbund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que UsageNow acceda a tu inicio de sesión de Claude Code en el Llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez UsageNow à accéder à votre connexion Claude Code dans le trousseau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לאשר ל־UsageNow גישה לפרטי ההתחברות של Claude Code במחזיק המפתחות."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーチェーン内のClaude Codeのサインイン情報へのアクセスをUsageNowに許可してください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow-ға Кілттер тізбегіндегі Claude Code сеансына қол жеткізуге рұқсат беріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
