        }
      }
    },
    "The balance can’t pay for more requests." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Guthaben reicht für keine weiteren Anfragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El saldo no alcanza para más solicitudes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le solde ne permet plus de payer de requêtes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баланса не хватает на новые запросы."
          }
        }
      }
    },
    "The full limit is available again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das volle Limit ist wieder verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelves a tener el límite completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite complète est de nouveau disponible."
          }
        },
