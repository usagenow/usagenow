    "No sign-in or sessions in this account’s folder. Check it in Settings › Providers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Ordner dieses Accounts gibt es weder Anmeldung noch Sitzungen. Prüfe ihn unter Einstellungen › Anbieter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta de esta cuenta no tiene inicio de sesión ni sesiones. Revísala en Ajustes › Proveedores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier de ce compte ne contient ni connexion ni sessions. Vérifiez-le dans Réglages › Fournisseurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בתיקייה של החשבון הזה אין התחברות ואין סשנים. כדאי לבדוק אותה בהגדרות › ספקים."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントのフォルダにはサインイン情報もセッションもありません。“設定” › “プロバイダ”で確認してください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунт қалтасында кіру деректері не сеанстар жоқ. Параметрлер › Провайдерлер бөлімінде тексеріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 계정의 폴더에 로그인 정보나 세션이 없습니다. 설정 › 제공업체에서 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen aanmelding of sessies in de map van dit account. Controleer de map in Instellingen › Providers."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta desta conta não tem login nem sessões. Verifique-a em Ajustes › Provedores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В папке этого аккаунта нет ни входа, ни сессий. Проверьте её в Настройки › Провайдеры."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hesabın klasöründe giriş veya oturum yok. Ayarlar › Sağlayıcılar bölümünde denetleyin."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hisob jildida kiriş yoki seanslar yöq. Sozlamalar › Provayderlar bölimida tekşiring."
          }
        }
      }
    },
    "No valid session yet. Finish signing in, or use the manual session cookie option." : {
