    "Limits are checked when UsageNow refreshes. Notifications come from this Mac; nothing is sent anywhere." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limits werden geprüft, wenn UsageNow aktualisiert. Mitteilungen kommen von diesem Mac; nichts wird irgendwohin gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los límites se comprueban cuando UsageNow se actualiza. Las notificaciones vienen de este Mac; no se envía nada a ningún sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
