    "What’s left of your AI coding limits, at a glance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was von deinen KI-Coding-Limits übrig ist, auf einen Blick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que queda de tus límites de IA para programar, de un vistazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qu’il reste de vos limites d’IA pour coder, en un coup d’œil."
