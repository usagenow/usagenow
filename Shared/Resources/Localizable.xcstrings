{
  "sourceLanguage" : "en",
  "strings" : {
    "JetBrains AI usage" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "JetBrains AI-Nutzung" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Uso de JetBrains AI" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Utilisation de JetBrains AI" } },
        "he" : { "stringUnit" : { "state" : "translated", "value" : "שימוש ב-JetBrains AI" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "JetBrains AIの使用量" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "JetBrains AI 사용량" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "JetBrains AI-gebruik" } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Uso do JetBrains AI" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Использование JetBrains AI" } }
      }
    },
    "Track AI Assistant limits from your JetBrains IDE." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "AI Assistant-Limits aus deiner JetBrains-IDE verfolgen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Consulta los límites de AI Assistant desde tu IDE de JetBrains." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Suivez les limites d’AI Assistant depuis votre IDE JetBrains." } },
        "he" : { "stringUnit" : { "state" : "translated", "value" : "מעקב אחר מגבלות AI Assistant מתוך סביבת הפיתוח של JetBrains." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "JetBrains IDEからAI Assistantの上限を確認します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "JetBrains IDE에서 AI Assistant 한도를 확인합니다." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Volg de AI Assistant-limieten uit je JetBrains-IDE." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Acompanhe os limites do AI Assistant no seu IDE JetBrains." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Лимиты AI Assistant из вашей IDE JetBrains." } }
      }
    },
    "Open a JetBrains IDE with AI Assistant enabled to update usage limits." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Öffne eine JetBrains-IDE mit aktiviertem AI Assistant, um die Nutzungslimits zu aktualisieren." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Abre un IDE de JetBrains con AI Assistant activado para actualizar los límites de uso." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvrez un IDE JetBrains avec AI Assistant activé pour actualiser les limites d’utilisation." } },
        "he" : { "stringUnit" : { "state" : "translated", "value" : "יש לפתוח סביבת פיתוח של JetBrains עם AI Assistant פעיל כדי לעדכן את מגבלות השימוש." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "使用上限を更新するには、AI Assistantを有効にしたJetBrains IDEを開いてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용 한도를 업데이트하려면 AI Assistant가 활성화된 JetBrains IDE를 여세요." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Open een JetBrains-IDE met AI Assistant ingeschakeld om de gebruikslimieten bij te werken." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Abra um IDE JetBrains com o AI Assistant ativado para atualizar os limites de uso." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Откройте IDE JetBrains с включённым AI Assistant, чтобы обновить лимиты." } }
      }
    },
