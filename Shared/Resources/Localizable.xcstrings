    "%@ rejected the connection. Sign in again or replace the credential in Settings › Providers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat die Verbindung abgelehnt. Melde dich neu an oder ersetze die Zugangsdaten unter Einstellungen › Anbieter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rechazó la conexión. Inicia sesión de nuevo o cambia la credencial en Ajustes › Proveedores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a refusé la connexion. Reconnectez-vous ou remplacez l’identifiant dans Réglages › Fournisseurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ דחה את החיבור. היכנסו שוב או החליפו את פרטי האימות בהגדרות › ספקים."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が接続を拒否しました。再度サインインするか、設定 › プロバイダで認証情報を変更してください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ қосылымды қабылдамады. Қайта кіріңіз немесе Параметрлер › Провайдерлер бөлімінде кіру деректерін ауыстырыңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 연결을 거부했습니다. 다시 로그인하거나 설정 › 제공업체에서 인증 정보를 변경하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
