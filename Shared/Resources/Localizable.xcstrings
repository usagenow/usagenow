    "Signed-in usage couldn’t be verified. This account or response may not be supported; nothing has been saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nutzung konnte nicht geprüft werden. Dieses Konto oder Antwortformat wird möglicherweise nicht unterstützt. Es wurde nichts gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar el uso. Es posible que esta cuenta o respuesta no sea compatible; no se ha guardado nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’utilisation n’a pas pu être vérifiée. Ce compte ou ce format de réponse n’est peut-être pas pris en charge ; rien n’a été enregistré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לאמת את השימוש. ייתכן שהחשבון או פורמט התשובה אינם נתמכים; לא נשמר דבר."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用量を確認できませんでした。このアカウントまたは応答形式には対応していない可能性があります。何も保存されていません。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанс қолданысы тексерілмеді. Бұл аккаунт не жауап пішімі қолдау таппауы мүмкін; ештеңе сақталмады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용량을 확인할 수 없습니다. 이 계정 또는 응답 형식이 지원되지 않을 수 있습니다. 저장된 내용은 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het verbruik van het ingelogde account kon niet worden gecontroleerd. Dit account of antwoord wordt mogelijk niet ondersteund; er is niets opgeslagen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar o uso. Esta conta ou resposta pode não ser compatível; nada foi salvo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось проверить статистику. Этот аккаунт или формат ответа может не поддерживаться. Ничего не сохранено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum kullanımı doğrulanamadı. Bu hesap veya yanıt desteklenmiyor olabilir; hiçbir şey kaydedilmedi."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seans sarfi tekşirilmadi. Bu hisob yoki javob formati qöllanmasligi mumkin; heç narsa saqlanmadi."
          }
        }
      }
    },
