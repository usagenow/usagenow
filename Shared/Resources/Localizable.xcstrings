        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung konnte nicht gesichert werden. Prüfe das Format und den Schlüsselbundzugriff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar la conexión. Revisa el formato y el acceso al Llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer la connexion. Vérifiez le format et l’accès au trousseau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לשמור את החיבור. בדקו את הפורמט ואת הגישה למחזיק המפתחות."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続を保存できません。認証情報の形式とキーチェーンへのアクセスを確認してください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қосылым сақталмады. Кіру деректерінің пішімі мен Кілттер тізбегіне рұқсатты тексеріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결을 저장할 수 없습니다. 인증 정보 형식과 키체인 접근을 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding kon niet worden opgeslagen. Controleer de notatie van de toegangsgegevens en de toegang tot Sleutelhanger."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível salvar a conexão. Verifique o formato e o acesso às Chaves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить подключение. Проверьте формат данных и доступ к Связке ключей."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı kaydedilemedi. Kimlik bilgisi biçimini ve Anahtar Zinciri erişimini denetleyin."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulaniş saqlanmadi. Kiriş ma’lumoti formati va Keychain ruxsatini tekşiring."
          }
        }
      }
    },
    "Couldn’t verify this session. Try again or use the manual session cookie option." : {
