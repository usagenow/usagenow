    },
    "UsageNow installs an update only when it's signed with the UsageNow update key. Checking sends no information about you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow installiert ein Update nur, wenn es mit dem UsageNow-Update-Schlüssel signiert ist. Bei der Suche werden keine Informationen über dich gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow solo instala una actualización si está firmada con la clave de actualización de UsageNow. Al comprobar no se envía información sobre ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow n’installe une mise à jour que si elle est signée avec la clé de mise à jour de UsageNow. La vérification n’envoie aucune information vous concernant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow מתקין עדכון רק אם הוא חתום במפתח העדכונים של UsageNow. הבדיקה לא שולחת שום מידע עליך."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNowは、UsageNowのアップデート用キーで署名されたアップデートだけをインストールします。確認の際にあなたに関する情報は送信されません。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow жаңартуды тек UsageNow жаңарту кілтімен қол қойылғанда орнатады. Тексеру сіз туралы ақпарат жібермейді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow는 UsageNow 업데이트 키로 서명된 업데이트만 설치합니다. 확인할 때 사용자에 대한 정보는 전송되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow installeert een update alleen als deze met de UsageNow-updatesleutel is ondertekend. Bij het controleren worden geen gegevens over jou verstuurd."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O UsageNow só instala uma atualização assinada com a chave de atualização do UsageNow. A verificação não envia nenhuma informação sobre você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow устанавливает обновление, только если оно подписано ключом обновлений UsageNow. Проверка не передаёт никаких сведений о вас."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow yalnızca UsageNow güncelleme anahtarıyla imzalanmış güncellemeleri yükler. Denetleme sizinle ilgili bilgi göndermez."
          }
