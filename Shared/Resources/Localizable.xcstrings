        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIコーディングの制限の残りがひと目でわかります。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ЖИ бағдарламалау лимиттерінің қалдығын бір қарағанда көріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 코딩 한도가 얼마나 남았는지 한눈에 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
