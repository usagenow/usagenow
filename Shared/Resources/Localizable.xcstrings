    "Sets change what you see. Enabled accounts keep updating and sending notifications." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наборы меняют отображение. Включённые аккаунты продолжают обновляться и отправлять уведомления."
          }
        },
        "de" : {
          "stringUnit" : {
