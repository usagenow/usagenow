    "The service couldn’t be reached. Try again later; nothing has been saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst ist nicht erreichbar. Versuche es später erneut. Es wurde nichts gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo contactar con el servicio. Inténtalo más tarde; no se ha guardado nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service est injoignable. Réessayez plus tard ; rien n’a été enregistré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן להגיע לשירות. נסו שוב מאוחר יותר; לא נשמר דבר."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サービスに接続できませんでした。後でもう一度お試しください。何も保存されていません。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервиске қосылу мүмкін болмады. Кейін қайталаңыз; ештеңе сақталмады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서비스에 연결할 수 없습니다. 나중에 다시 시도하십시오. 저장된 내용은 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De dienst kon niet worden bereikt. Probeer het later opnieuw; er is niets opgeslagen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar o serviço. Tente mais tarde; nada foi salvo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось связаться с сервисом. Повторите попытку позже. Ничего не сохранено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hizmete ulaşılamadı. Daha sonra deneyin; hiçbir şey kaydedilmedi."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xizmatga ulanib bölmadi. Keyinroq urinib köring; heç narsa saqlanmadi."
          }
        }
      }
    },
    "The service rejected this connection. Check the credential and its permissions, or sign in again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst hat die Verbindung abgelehnt. Prüfe die Zugangsdaten und Berechtigungen oder melde dich erneut an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio rechazó la conexión. Revisa la credencial y sus permisos o inicia sesión de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service a refusé la connexion. Vérifiez les identifiants et leurs autorisations, ou reconnectez-vous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השירות דחה את החיבור. בדקו את פרטי הגישה וההרשאות או היכנסו שוב."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サービスが接続を拒否しました。認証情報と権限を確認するか、再度サインインしてください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервис қосылымды қабылдамады. Кіру деректері мен рұқсаттарын тексеріңіз немесе қайта кіріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서비스에서 연결을 거부했습니다. 인증 정보와 권한을 확인하거나 다시 로그인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De dienst heeft deze verbinding geweigerd. Controleer de toegangsgegevens en machtigingen of log opnieuw in."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O serviço recusou a conexão. Verifique a credencial e suas permissões ou entre novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервис отклонил подключение. Проверьте данные и права доступа или войдите снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hizmet bu bağlantıyı reddetti. Kimlik bilgisini ve izinlerini denetleyin veya yeniden giriş yapın."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xizmat ulanişni rad etdi. Kiriş ma’lumoti va ruxsatlarini tekşiring yoki qayta kiring."
          }
        }
      }
    },
    "This build can't update itself: it wasn't made by the release process, which is what signs an update." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Build kann sich nicht selbst aktualisieren: Er stammt nicht aus dem Release-Prozess, der Updates signiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta compilación no puede actualizarse sola: no se creó con el proceso de publicación, que es el que firma las actualizaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version ne peut pas se mettre à jour seule : elle n’a pas été créée par le processus de publication, qui signe les mises à jour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגרסה הזו לא יכולה להתעדכן בעצמה: היא לא נבנתה בתהליך השחרור, שהוא זה שחותם על עדכונים."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビルドは自動でアップデートできません。アップデートに署名するリリース処理で作成されたものではないためです。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл жинақ өздігінен жаңармайды: ол жаңартуға қол қоятын релиз үдерісімен жасалмаған."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 빌드는 자동으로 업데이트할 수 없습니다. 업데이트에 서명하는 릴리스 과정으로 만들어지지 않았기 때문입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze build kan zichzelf niet bijwerken: hij is niet via het releaseproces gemaakt dat updates ondertekent."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão não pode se atualizar sozinha: ela não foi criada pelo processo de lançamento, que é o que assina as atualizações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта сборка не может обновляться сама: она собрана не в процессе выпуска, который подписывает обновления."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu derleme kendini güncelleyemez: güncellemeyi imzalayan yayın süreciyle oluşturulmadı."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yiğma özini yangilay olmaydi: u yangilanişni imzolaydigan reliz jarayonida yaratilmagan."
