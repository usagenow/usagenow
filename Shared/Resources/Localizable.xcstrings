    "Add ~/.local/bin to your PATH if needed. Shell settings are never changed automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge bei Bedarf ~/.local/bin zum PATH hinzu. Shell-Einstellungen werden nie automatisch geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade ~/.local/bin a PATH si hace falta. La configuración del shell no se cambia automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez ~/.local/bin au PATH si nécessaire. Les réglages du shell ne sont jamais modifiés automatiquement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסיפו את ~/.local/bin ל-PATH לפי הצורך. הגדרות המעטפת אינן משתנות אוטומטית."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要に応じて~/.local/binをPATHに追加してください。シェル設定は自動変更されません。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қажет болса, PATH айнымалысына ~/.local/bin қосыңыз. Shell параметрлері автоматты өзгермейді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필요하면 ~/.local/bin을 PATH에 추가하세요. 셸 설정은 자동으로 변경하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg zo nodig ~/.local/bin toe aan PATH. Shellinstellingen worden nooit automatisch gewijzigd."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione ~/.local/bin ao PATH se necessário. As definições da shell nunca são alteradas automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При необходимости добавьте ~/.local/bin в PATH. Настройки shell автоматически не меняются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerekirse PATH’inize ~/.local/bin ekleyin. Kabuk ayarları otomatik değiştirilmez."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerak bölsa, PATH’ga ~/.local/bin qöşing. Shell sozlamalari avtomatik özgarmaydi."
          }
        }
      }
    },
