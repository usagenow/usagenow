    "See your remaining limits and reset times, and add a widget to your desktop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh verbleibende Limits und Reset-Zeiten und füge ein Widget zum Schreibtisch hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta los límites restantes y sus reinicios, y añade un widget al escritorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez vos limites restantes et leurs réinitialisations, et ajoutez un widget au bureau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צפו במכסות שנותרו ובזמני האיפוס והוסיפו ווידג׳ט לשולחן העבודה."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上限の残量とリセット時刻を確認し、デスクトップにウィジェットを追加できます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қалған лимиттер мен жаңару уақытын көріңіз және жұмыс үстеліне виджет қосыңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
