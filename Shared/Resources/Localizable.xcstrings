    "Connection verified, but it couldn’t be saved. Check Keychain access and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung wurde geprüft, konnte aber nicht gesichert werden. Prüfe den Schlüsselbundzugriff und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexión verificada, pero no se pudo guardar. Revisa el acceso al Llavero e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion vérifiée, mais impossible à enregistrer. Vérifiez l’accès au trousseau et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החיבור אומת אך לא נשמר. בדקו את הגישה למחזיק המפתחות ונסו שוב."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続を確認しましたが、保存できませんでした。キーチェーンへのアクセスを確認して、もう一度お試しください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қосылым тексерілді, бірақ сақталмады. Кілттер тізбегіне рұқсатты тексеріп, қайталаңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결은 확인되었지만 저장하지 못했습니다. 키체인 접근 권한을 확인한 후 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding is gecontroleerd, maar kon niet worden opgeslagen. Controleer de toegang tot Sleutelhanger en probeer het opnieuw."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexão verificada, mas não foi possível salvá-la. Verifique o acesso às Chaves e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключение проверено, но не сохранено. Проверьте доступ к Связке ключей и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı doğrulandı ancak kaydedilemedi. Anahtar Zinciri erişimini denetleyip yeniden deneyin."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulaniş tekşirildi, ammo saqlanmadi. Keychain ruxsatini tekşirib, qayta urinib köring."
          }
        }
      }
    },
