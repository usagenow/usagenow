        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה נשאר ממגבלות ה־AI לתכנות, במבט אחד."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIコーディングの制限の残りがひと目でわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 코딩 한도가 얼마나 남았는지 한눈에 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je resterende AI-codelimieten in één oogopslag."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que resta dos seus limites de IA para programar, num relance."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остаток лимитов ИИ для программирования — с первого взгляда."
          }
        }
      }
    },
    "When 20% and 5% of a limit are left, and when a limit you were warned about resets." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn 20 % und 5 % eines Limits übrig sind und wenn ein Limit, vor dem du gewarnt wurdest, zurückgesetzt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando queda el 20 % y el 5 % de un límite, y cuando se restablece un límite del que se te avisó."
