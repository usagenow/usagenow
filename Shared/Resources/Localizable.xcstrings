    "Signed-in usage couldn’t be verified. This account or response may not be supported; nothing has been saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nutzung konnte nicht geprüft werden. Dieses Konto oder Antwortformat wird möglicherweise nicht unterstützt. Es wurde nichts gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar el uso. Es posible que esta cuenta o respuesta no sea compatible; no se ha guardado nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’utilisation n’a pas pu être vérifiée. Ce compte ou ce format de réponse n’est peut-être pas pris en charge ; rien n’a été enregistré."
