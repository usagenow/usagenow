    "%@ didn’t accept the API key. Check it in Settings › Providers." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat den API-Schlüssel nicht akzeptiert. Prüfe ihn unter Einstellungen › Anbieter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no aceptó la clave de API. Revísala en Ajustes › Proveedores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas accepté la clé d’API. Vérifiez-la dans Réglages › Fournisseurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ לא קיבל את מפתח ה־API. כדאי לבדוק אותו בהגדרות › ספקים."
