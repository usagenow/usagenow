          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow werkt in de eerste plaats lokaal. Je verbruiksgegevens blijven op deze Mac."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O UsageNow funciona localmente. Seus dados de uso ficam neste Mac."
          }
