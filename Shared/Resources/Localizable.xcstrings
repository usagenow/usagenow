    "The UsageNow name, logo, icon, and other brand assets are not covered by the MIT License." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name, Logo, Symbol und andere Markenelemente von UsageNow fallen nicht unter die MIT-Lizenz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre, el logotipo, el icono y otros elementos de marca de UsageNow no están cubiertos por la licencia MIT."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom, le logo, l’icône et les autres éléments de marque de UsageNow ne sont pas couverts par la licence MIT."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השם, הלוגו, הצלמית ושאר נכסי המותג של UsageNow אינם מכוסים ברישיון MIT."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNowの名称、ロゴ、アイコン、その他のブランド資産はMITライセンスの対象外です。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow атауы, логотипі, белгішесі және басқа бренд материалдары MIT лицензиясымен қамтылмайды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow 이름, 로고, 아이콘 및 기타 브랜드 자산은 MIT 라이선스의 적용을 받지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De naam, het logo, het pictogram en andere merkuitingen van UsageNow vallen niet onder de MIT-licentie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome, o logotipo, o ícone e outros elementos da marca UsageNow não são cobertos pela Licença MIT."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Название, логотип, значок и другие элементы бренда UsageNow не подпадают под лицензию MIT."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow adı, logosu, simgesi ve diğer marka varlıkları MIT Lisansı kapsamında değildir."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow nomi, logotipi, belgisi va boşqa brend materiallari MIT litsenziyasiga kirmaydi."
          }
        }
      }
    },
    "The balance can’t pay for more requests." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
