    "%@ didn’t accept the API key. Check it in Settings › Providers." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat den API-Schlüssel nicht akzeptiert. Prüfe ihn unter Einstellungen › Anbieter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no aceptó la clave de API. Revísala en Ajustes › Proveedores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas accepté la clé d’API. Vérifiez-la dans Réglages › Fournisseurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ לא קיבל את מפתח ה־API. כדאי לבדוק אותו בהגדרות › ספקים."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がAPIキーを受け付けませんでした。“設定” › “プロバイダ”で確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 API 키를 받아들이지 않았습니다. 설정 › 제공업체에서 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft de API-sleutel geweigerd. Controleer deze in Instellingen › Providers."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %@ não aceitou a chave de API. Verifique-a em Ajustes › Provedores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не принял ключ API. Проверьте его в Настройки › Провайдеры."
