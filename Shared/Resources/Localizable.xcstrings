          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow wisselt van taal na een herstart."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O UsageNow muda de idioma ao reiniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow сменит язык после перезапуска."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow yeniden başlatıldığında dil değişir."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow qayta işga tuşirilganda til özgaradi."
          }
        }
      }
    },
    "UsageNow uses this key only to read your usage from %@. It stays in the Keychain on this Mac, is never sent anywhere else, and is deleted when you turn %@ off." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow verwendet diesen Schlüssel nur, um deine Nutzung bei %1$@ zu lesen. Er bleibt im Schlüsselbund dieses Mac, wird nirgendwohin sonst gesendet und wird gelöscht, wenn du %2$@ ausschaltest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "UsageNow uses this key only to read your usage from %1$@. It stays in the Keychain on this Mac, is never sent anywhere else, and is deleted when you turn %2$@ off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow usa esta clave solo para leer tu uso en %1$@. Se queda en el Llavero de este Mac, nunca se envía a ningún otro sitio y se elimina cuando desactivas %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow utilise cette clé uniquement pour lire votre utilisation auprès de %1$@. Elle reste dans le trousseau de ce Mac, n’est envoyée nulle part ailleurs et est supprimée lorsque vous désactivez %2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow משתמש במפתח הזה רק כדי לקרוא את השימוש שלך מ־%1$@. הוא נשמר במחזיק המפתחות של ה־Mac הזה, לעולם לא נשלח לשום מקום אחר, ונמחק כשמכבים את %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNowはこのキーを%1$@から使用量を読み取るためだけに使います。キーはこのMacのキーチェーンに保管され、ほかの場所に送信されることはなく、%2$@をオフにすると削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow는 %1$@에서 사용량을 읽는 데만 이 키를 사용합니다. 키는 이 Mac의 키체인에 보관되며 다른 곳으로 전송되지 않고, %2$@을(를) 끄면 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow gebruikt deze sleutel alleen om je verbruik bij %1$@ te lezen. De sleutel blijft in Sleutelhanger op deze Mac, wordt nooit ergens anders naartoe gestuurd en wordt verwijderd wanneer je %2$@ uitschakelt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O UsageNow usa esta chave só para ler o seu uso no %1$@. Ela fica nas Chaves deste Mac, nunca é enviada para outro lugar e é apagada quando você desativa o %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow использует этот ключ только для чтения вашего использования у %1$@. Он хранится в Связке ключей этого Mac, никуда больше не отправляется и удаляется, когда вы выключаете %2$@."
          }
        }
      }
    },
    "Use your own GitHub token. Copilot access depends on the token and account; the experimental API may reject personal tokens. UsageNow does not sign in as VS Code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende deinen eigenen GitHub-Token. Der Copilot-Zugriff hängt von Token und Konto ab; die experimentelle API kann persönliche Tokens ablehnen. UsageNow meldet sich nicht als VS Code an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa tu propio token de GitHub. El acceso a Copilot depende del token y la cuenta; la API experimental puede rechazar tokens personales. UsageNow no inicia sesión como VS Code."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez votre propre jeton GitHub. L’accès Copilot dépend du jeton et du compte ; l’API expérimentale peut refuser les jetons personnels. UsageNow ne se connecte pas en tant que VS Code."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השתמשו בטוקן GitHub שלכם. הגישה ל־Copilot תלויה בטוקן ובחשבון; ה־API הניסיוני עלול לדחות טוקנים אישיים. UsageNow לא נכנס בשם VS Code."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご自身のGitHubトークンを使用してください。Copilotへのアクセスはトークンとアカウントに依存し、実験的APIは個人トークンを拒否する場合があります。UsageNowはVS Codeとしてサインインしません。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өзіңіздің GitHub токеніңізді қолданыңыз. Copilot қолжетімділігі токен мен аккаунтқа байланысты; сынақ API жеке токенді қабылдамауы мүмкін. UsageNow VS Code атынан кірмейді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "본인의 GitHub 토큰을 사용하십시오. Copilot 접근은 토큰과 계정에 따라 다르며 실험적 API는 개인 토큰을 거부할 수 있습니다. UsageNow는 VS Code로 로그인하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik je eigen GitHub-token. Toegang tot Copilot hangt af van het token en het account; de experimentele API kan persoonlijke tokens weigeren. UsageNow logt niet in namens VS Code."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use seu próprio token do GitHub. O acesso ao Copilot depende do token e da conta; a API experimental pode recusar tokens pessoais. O UsageNow não entra como VS Code."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте свой токен GitHub. Доступ Copilot зависит от токена и аккаунта; экспериментальный API может отклонить личный токен. UsageNow не входит от имени VS Code."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi GitHub token’ınızı kullanın. Copilot erişimi token’a ve hesaba bağlıdır; deneysel API kişisel token’ları reddedebilir. UsageNow VS Code kimliğiyle giriş yapmaz."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öz GitHub tokeningizdan foydalaning. Copilot’ga kiriş token va hisobga boğliq; tajribaviy API şaxsiy tokenni rad etişi mumkin. UsageNow VS Code nomidan kirmaydi."
          }
        }
      }
    },
