    "Couldn’t install the command. Check the folder permissions or an existing usagenow command." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Befehl konnte nicht installiert werden. Prüfe Ordnerrechte oder einen vorhandenen usagenow-Befehl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo instalar el comando. Revisa los permisos de la carpeta o un comando usagenow existente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’installer la commande. Vérifiez les droits du dossier ou une commande usagenow existante."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן להתקין את הפקודה. בדקו את הרשאות התיקייה או פקודת usagenow קיימת."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドをインストールできませんでした。フォルダの権限や既存のusagenowコマンドを確認してください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команда орнатылмады. Қалта рұқсаттарын немесе бұрынғы usagenow командасын тексеріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령을 설치하지 못했습니다. 폴더 권한이나 기존 usagenow 명령을 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opdracht kon niet worden geïnstalleerd. Controleer maprechten of een bestaande usagenow-opdracht."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível instalar o comando. Verifique as permissões da pasta ou um comando usagenow existente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось установить команду. Проверьте права папки или существующую команду usagenow."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komut yüklenemedi. Klasör izinlerini veya mevcut usagenow komutunu denetleyin."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buyruq örnatilmadi. Jild ruxsatlarini yoki mavjud usagenow buyruğini tekşiring."
          }
        }
      }
    },
