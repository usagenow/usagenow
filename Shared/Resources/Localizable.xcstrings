    "Never includes prompts, tokens, project names, files, credentials, or coding activity." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält niemals Prompts, Tokens, Projektnamen, Dateien, Zugangsdaten oder Programmieraktivität."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca incluye prompts, tokens, nombres de proyectos, archivos, credenciales ni actividad de programación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’inclut jamais de prompts, de tokens, de noms de projet, de fichiers, d’identifiants ni d’activité de code."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לעולם לא כולל הנחיות, טוקנים, שמות פרויקטים, קבצים, פרטי גישה או פעילות תכנות."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロンプト、トークン、プロジェクト名、ファイル、認証情報、コーディング作業の内容は一切含まれません。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Промпттар, токендер, жоба атаулары, файлдар, кіру деректері немесе код жазу белсенділігі ешқашан қамтылмайды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프롬프트, 토큰, 프로젝트 이름, 파일, 자격 증명 또는 코딩 활동은 절대 포함되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevat nooit prompts, tokens, projectnamen, bestanden, toegangsgegevens of programmeeractiviteit."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca inclui prompts, tokens, nomes de projetos, arquivos, credenciais nem atividade de programação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никогда не включает промпты, токены, названия проектов, файлы, учётные данные или код."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstemleri, tokenları, proje adlarını, dosyaları, kimlik bilgilerini veya kodlama etkinliğini asla içermez."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sörov matnlari, tokenlar, loyiha nomlari, fayllar, kiriş ma’lumotlari yoki kodlaş faolligi heç qaçon kiritilmaydi."
          }
        }
      }
