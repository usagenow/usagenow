        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UsageNow에는 타사 코드가 포함되어 있지 않습니다. UsageNow의 소스 코드는 MIT 라이선스로 제공됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
