        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand il reste 20 % et 5 % d’une limite, et quand une limite pour laquelle vous avez été averti est réinitialisée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשנותרו 20% ו־5% ממגבלה, וכשמגבלה שקיבלת עליה אזהרה מתאפסת."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制限の残りが20%と5%になったとき、および通知を受けた制限がリセットされたとき。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한도가 20%와 5% 남았을 때, 그리고 알림을 받은 한도가 재설정될 때."
