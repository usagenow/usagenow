    "Helps improve UsageNow by sharing basic app usage and device information." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilft, UsageNow zu verbessern, indem grundlegende Infos zur App-Nutzung und zum Gerät geteilt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuda a mejorar UsageNow compartiendo información básica sobre el uso de la app y el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aide à améliorer UsageNow en partageant des informations de base sur l’utilisation de l’app et l’appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עוזר לשפר את UsageNow באמצעות שיתוף מידע בסיסי על השימוש ביישום ועל המכשיר."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの基本的な使用状況とデバイスの情報を共有して、UsageNowの改善に役立てます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қолданба мен құрылғы туралы негізгі ақпаратты бөлісу арқылы UsageNow-ды жақсартуға көмектеседі."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적인 앱 사용 및 기기 정보를 공유하여 UsageNow 개선에 도움을 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Help UsageNow te verbeteren door basisgegevens over appgebruik en je apparaat te delen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuda a melhorar o UsageNow compartilhando informações básicas de uso do app e do dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помогает улучшать UsageNow: передаёт общие сведения об использовании приложения и устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temel uygulama kullanımı ve aygıt bilgilerini paylaşarak UsageNow’un geliştirilmesine yardımcı olur."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dastur va qurilma haqida asosiy ma’lumotlarni ulaşib, UsageNow’ni yaxşilaşga yordam beradi."
          }
        }
      }
    },
