    "Choose up to four accounts. Each icon shows its most critical limit." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите до четырёх аккаунтов. Рядом с каждой иконкой показан наиболее критичный лимит."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie bis zu vier Accounts. Jedes Symbol zeigt das kritischste Limit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige hasta cuatro cuentas. Cada icono muestra su límite más crítico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez jusqu’à quatre comptes. Chaque icône affiche sa limite la plus critique."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies maximaal vier accounts. Elk symbool toont de meest kritieke limiet."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha até quatro contas. Cada ícone mostra seu limite mais crítico."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לבחור עד ארבעה חשבונות. כל סמל מציג את המכסה הקריטית ביותר שלו."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大4つのアカウントを選択できます。各アイコンに最も余裕の少ない利用枠を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 최대 4개 선택하세요. 각 아이콘에 가장 여유가 적은 한도를 표시합니다."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Төрт аккаунтқа дейін таңдаңыз. Әр белгіше ең аз қалған лимитті көрсетеді."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Törttagaça hisob tanlang. Har bir belgi eng kam qolgan limitni körsatadi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fazla dört hesap seçin. Her simge en kritik sınırını gösterir."
          }
        }
      }
