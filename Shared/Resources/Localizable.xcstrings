    "Show selected provider icons and usage side by side in the menu bar." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывайте иконки выбранных провайдеров и их лимиты рядом в строке меню."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigen Sie ausgewählte Anbietersymbole und ihre Nutzung nebeneinander in der Menüleiste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra los iconos de los proveedores seleccionados y su uso juntos en la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez côte à côte les icônes des fournisseurs sélectionnés et leur utilisation dans la barre des menus."
          }
        },
        "nl" : {
