          }
        }
      }
    },
    "When 20% and 5% of a limit are left, and when a limit you were warned about resets." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn 20 % und 5 % eines Limits übrig sind und wenn ein Limit, vor dem du gewarnt wurdest, zurückgesetzt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando queda el 20 % y el 5 % de un límite, y cuando se restablece un límite del que se te avisó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand il reste 20 % et 5 % d’une limite, et quand une limite pour laquelle vous avez été averti est réinitialisée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשנותרו 20% ו־5% ממגבלה, וכשמגבלה שקיבלת עליה אזהרה מתאפסת."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制限の残りが20%と5%になったとき、および通知を受けた制限がリセットされたとき。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лимиттің 20% және 5% қалғанында және ескертілген лимит жаңарғанда."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한도가 20%와 5% 남았을 때, 그리고 알림을 받은 한도가 재설정될 때."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer 20% en 5% van een limiet over is en wanneer een limiet waarover je bent gewaarschuwd wordt gereset."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando restam 20% e 5% de um limite, e quando um limite sobre o qual você foi avisado é redefinido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда остаётся 20% и 5% лимита, и когда лимит, о котором вы были предупреждены, обновится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
